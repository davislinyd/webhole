{
  "manifest_version": 3,
  "name": "Webhole",
  "version": "0.1.0",
  "description": "Switch Chrome proxy modes for a local SOCKS5 tunnel.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "proxy",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Webhole",
    "default_popup": "popup.html"
  }
}
