{
  "manifest_version": 3,
  "name": "Webhole",
  "version": "0.4.2",
  "description": "SSH SOCKS routes + DNS Enforce (browser must use configured nameservers).",
  "key": "",
  "icons": {
    "16": "icons/disconnected/icon-16.png",
    "32": "icons/disconnected/icon-32.png",
    "48": "icons/disconnected/icon-48.png",
    "128": "icons/disconnected/icon-128.png"
  },
  "permissions": [
    "nativeMessaging",
    "proxy",
    "storage",
    "privacy"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Webhole",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/disconnected/icon-16.png",
      "32": "icons/disconnected/icon-32.png",
      "48": "icons/disconnected/icon-48.png",
      "128": "icons/disconnected/icon-128.png"
    }
  },
  "commands": {
    "open-webhole": {
      "suggested_key": {
        "default": "Alt+Shift+W",
        "mac": "Alt+Shift+W"
      },
      "description": "Open Webhole in a stable popup window"
    }
  }
}
